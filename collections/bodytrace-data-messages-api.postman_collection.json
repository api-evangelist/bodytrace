          "id": "1db51057-1c16-4a7b-8186-6805e742bfa2",
          "name": "Get raw device data messages",
          "request": {
            "name": "Get raw device data messages",
            "description": {
              "content": "Retrieve the raw, per-transmission messages a device has sent over the cellular network for a given IMEI and time range. Each message mirrors the payload BodyTrace devices emit (deviceId, ts, batteryVoltage, rssi, and a values object). MODELED - the message payload shape is confirmed from BodyTrace's documented device messages, but this read/query surface is gated behind partner credentials; verify path and parameters against your onboarding docs.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "device",
                ":imei",
                "datamessages"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "from",
                  "value": "<long>",
                  "description": "Start of the time window, epoch milliseconds (UTC)."
                },
                {
                  "disabled": false,
                  "key": "to",
                  "value": "<long>",
                  "description": "End of the time window, epoch milliseconds (UTC)."
                },
                {
                  "disabled": false,
                  "key": "limit",
                  "value": "<integer>",
                  "description": "Maximum number of messages to return."
                }
              ],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "imei",
                  "description": "(Required) The device IMEI (serial). BodyTrace documents this as the IMEI without leading zeros and without the final check digit."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "GET",
            "auth": null
